# Clé API Gemini — Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Webhook Discord du salon qui reçoit la veille
# (Paramètres du salon → Intégrations → Webhooks → Nouveau webhook)
DISCORD_WEBHOOK_URL=

# Modèle Gemini (optionnel, défaut : gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
